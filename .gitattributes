# Preserve collected source bytes even when core.autocrlf is enabled.
seo-data/2026-08-exp76-services/raw/** -text
seo-data/2026-08-exp76-services/raw/source-manifest.json text eol=lf

# Native Yandex exports may use CR-only records and delimiter-terminated rows.
# Treat them as opaque artifacts so whitespace checks do not rewrite or flag them.
seo-data/2026-08-exp76-services/raw/webmaster/*.csv binary
seo-data/2026-08-exp76-services/raw/wordstat/top-*.csv binary
seo-data/2026-08-exp76-services/raw/wordstat/dynamics-[0-9]*.csv binary
seo-data/2026-08-exp76-services/raw/wordcraft/*.xlsx binary

# Generated service hubs bind JSON metadata to exact rendered HTML bytes.
seo-content/service-hubs/hubs/*.json text eol=lf
ftp_dump_minimal/wp-content/themes/land76wp/content/service-v2/*.json text eol=lf
ftp_dump_minimal/wp-content/themes/land76wp/content/service-v2/rendered/*.html text eol=lf
