{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exp76.ru/schemas/legacy-article-content-v1.json",
  "title": "EXP76 production article",
  "type": "object",
  "required": [
    "schema_version",
    "destination_id",
    "service_id",
    "slug",
    "canonical",
    "post_title",
    "post_excerpt",
    "post_content",
    "featured_image_url",
    "acf",
    "internal_links",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "destination_id": {
      "type": "string",
      "pattern": "^S(9|1[0-5])-ARTICLE-[A-Z0-9-]+$"
    },
    "service_id": {
      "type": "string",
      "pattern": "^S(9|1[0-5])$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "canonical": {
      "type": "string",
      "pattern": "^https://exp76\\.ru/[a-z0-9-]+/$"
    },
    "post_title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "post_excerpt": {
      "type": "string",
      "minLength": 90
    },
    "post_content": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "featured_image_url": {
      "type": "string",
      "pattern": "^https://exp76\\.ru/wp-content/uploads/"
    },
    "acf": {
      "type": "object",
      "required": [
        "blogseo_hero_title",
        "blogseo_hero_subtitle",
        "blogseo_lead",
        "blogseo_main_image_url",
        "blogseo_main_image_alt",
        "blogseo_sections",
        "blogseo_cta_title",
        "blogseo_cta_text",
        "blogseo_cta_button_text",
        "blogseo_cta_button_url",
        "blogseo_faq_items",
        "blogseo_related_service_slugs",
        "blogseo_seo_title",
        "blogseo_seo_description"
      ],
      "properties": {
        "blogseo_hero_title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_hero_subtitle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_lead": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_main_image_url": {
          "type": "string",
          "pattern": "^https://exp76\\.ru/wp-content/uploads/"
        },
        "blogseo_main_image_alt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_sections": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "blogseo_cta_title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_cta_text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_cta_button_text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_cta_button_url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blogseo_faq_items": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/faq"
          }
        },
        "blogseo_related_service_slugs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "blogseo_seo_title": {
          "type": "string",
          "minLength": 35,
          "maxLength": 65
        },
        "blogseo_seo_description": {
          "type": "string",
          "minLength": 90,
          "maxLength": 180
        }
      },
      "additionalProperties": false
    },
    "internal_links": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/internalLink"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "point": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "heading",
        "body",
        "points"
      ],
      "properties": {
        "heading": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "body": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      },
      "additionalProperties": false
    },
    "faq": {
      "type": "object",
      "required": [
        "question",
        "answer"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "answer": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "internalLink": {
      "type": "object",
      "required": [
        "page_key",
        "url",
        "anchor"
      ],
      "properties": {
        "page_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "pattern": "^https://exp76\\.ru/"
        },
        "anchor": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "checked_date"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "checked_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    }
  }
}
